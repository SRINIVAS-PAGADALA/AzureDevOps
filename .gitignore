# Terraform working directory and generated files
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.plan
crash.log
crash.*.log

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Azure and local credentials
.azure/
.azuredevops/
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12

# Local Terraform overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# VS Code and local editor settings
.vscode/
*.code-workspace

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Local helper folder contents
/gitIgnore/*
!/gitIgnore/.gitkeep
